{
  "name": "patch",
  "version": "0.1.0",
  "private": true,
  "description": "A fast, quiet browser diff review loop for coding agents.",
  "type": "module",
  "scripts": {
    "dev": "vite build --watch & cargo run --release --manifest-path cli/Cargo.toml -- review --dev --local",
    "build": "vite build && cargo build --release --manifest-path cli/Cargo.toml",
    "install:local": "bun run build && ./cli/target/release/patchr install",
    "icons": "bun scripts/icons.ts",
    "themes": "bun scripts/themes.ts",
    "test": "cargo test --release --manifest-path cli/Cargo.toml && PATCHR=cli/target/release/patchr bun test ./tests/",
    "typecheck": "tsrs --noEmit -p tsconfig.json",
    "lint": "oxlint --deny-warnings .",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "check": "bun run typecheck && bun run lint && bun run format:check",
    "build:web": "vite build"
  },
  "dependencies": {
    "@pierre/diffs": "1.7.1",
    "@pierre/trees": "1.0.0",
    "@solidjs/web": "2.0.3",
    "@tanstack/hotkeys": "0.33.1",
    "@ui-sdk/core": "0.1.0-beta.16",
    "@ui-sdk/solid": "0.1.0-beta.16",
    "solid-js": "2.0.3"
  },
  "devDependencies": {
    "@babel/core": "8.1.3",
    "@pierre/icons": "0.9.0",
    "@solidjs/babel-plugin": "2.0.2",
    "@solidjs/vite-plugin": "3.0.1",
    "@types/bun": "1.4.5",
    "geist": "1.9.2",
    "oxfmt": "0.80.0",
    "oxlint": "1.95.0",
    "tsrs": "7.1.0-beta.tsrs5",
    "vite": "8.3.8"
  },
  "engines": {
    "bun": ">=1.4.5"
  },
  "packageManager": "bun@1.4.5"
}
