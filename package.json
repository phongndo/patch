{
  "name": "patch",
  "version": "0.2.1",
  "private": true,
  "description": "Review your coding agent's changes in the browser.",
  "type": "module",
  "scripts": {
    "dev": "bun scripts/dev.ts",
    "demo": "bun scripts/demo.ts",
    "build": "vite build && cargo build --release --manifest-path cli/Cargo.toml",
    "install:local": "bun run build && ./cli/target/release/patchr install",
    "icons": "bun scripts/icons.ts",
    "themes": "bun scripts/themes.ts",
    "test": "cargo build --manifest-path cli/Cargo.toml --all-targets && bun run --parallel test:rust test:cli",
    "test:rust": "cargo test --manifest-path cli/Cargo.toml",
    "test:cli": "cargo build --manifest-path cli/Cargo.toml && PATCHR=cli/target/debug/patchr bun test ./tests/",
    "test:web": "vitest run --config web/vitest.config.ts",
    "typecheck": "tsrs --noEmit -p tsconfig.json",
    "lint": "oxlint --deny-warnings .",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "format:rust": "cargo fmt --manifest-path cli/Cargo.toml --check",
    "lint:rust": "cargo clippy --manifest-path cli/Cargo.toml --all-targets --locked -- -D warnings",
    "check": "bun run typecheck && bun run lint && bun run format:check && bun run format:rust && bun run lint:rust",
    "bump": "bun scripts/release.ts bump",
    "build:web": "vite build",
    "bench": "bun run build && bun scripts/bench.ts"
  },
  "dependencies": {
    "@pierre/diffs": "1.7.1",
    "@pierre/trees": "1.0.0",
    "@solidjs/web": "2.0.3",
    "@tanstack/hotkeys": "0.33.1",
    "@ui-sdk/core": "0.1.0-beta.16",
    "@ui-sdk/solid": "0.1.0-beta.16",
    "dompurify": "3.5.0",
    "marked": "18.3.0",
    "solid-js": "2.0.3"
  },
  "devDependencies": {
    "@babel/core": "8.1.3",
    "@pierre/icons": "0.9.0",
    "@solidjs/babel-plugin": "2.0.2",
    "@solidjs/vite-plugin": "3.0.1",
    "@types/bun": "1.4.5",
    "geist": "1.9.2",
    "jsdom": "31.0.1",
    "oxfmt": "0.80.0",
    "oxlint": "1.95.0",
    "tsrs": "7.1.0-beta.tsrs5",
    "vite": "8.3.8",
    "vitest": "5.1.1"
  },
  "engines": {
    "bun": ">=1.4.5"
  },
  "packageManager": "bun@1.4.5",
  "patchedDependencies": {
    "solid-js@2.0.3": "patches/solid-js@2.0.3.patch",
    "@pierre/trees@1.0.0": "patches/@pierre%2Ftrees@1.0.0.patch"
  }
}
