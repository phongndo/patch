.{
    .name = .patch,
    .fingerprint = 0xe22b9636a05c2c1c,
    .version = "0.1.0",
    .minimum_zig_version = "0.16.0",
    .dependencies = .{
        // The same revision as @native-sdk/cli 0.11.0, whose npm release omits
        // a file its Zig build needs.
        .native_sdk = .{
            .url = "https://github.com/vercel-labs/native/archive/16f29572307c2cc133907537c4dfd98046d4e0f4.tar.gz",
            .hash = "native_sdk-0.1.0-hzDzQtsrRQOMvQE7lICRQ4Fe7VUxGuW2F9qteYlssJic",
        },
        // TextMate grammars, as Shiki bundles them; scripts/sync-grammars.mjs
        // writes src/native/grammars.zig from the same version.
        .tm_grammars = .{
            .url = "https://registry.npmjs.org/tm-grammars/-/tm-grammars-1.32.22.tgz",
            .hash = "N-V-__8AAKwwwwA2DIVnTqkoZPWWbQ83KfR6vtxK7sFZfNB8",
        },
    },
    .paths = .{ "build.zig", "build.zig.zon", "app.json", "src", "public", "dist" },
}
